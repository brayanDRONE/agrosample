        "body":  "\u003c!DOCTYPE html\u003e\n\u003chtml\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"utf-8\" /\u003e\n    \u003cmeta name=\"viewport\" content=\"[VALOR_SENSIBLE_REDACTADO]\" /\u003e\n    \u003ctitle\u003e - Agendamiento USDA\u003c/title\u003e\n    \u003c!-- Google Font: Source Sans Pro --\u003e\n    \u003clink rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700\u0026amp;display=fallback\"\u003e\n    \u003cstyle\u003e\n        #container-wrapper {\n            font-size: .90rem;\n        }\n    \u003c/style\u003e\n    \u003cscript\u003e\n        function SeparadorMilesInput(numero) {\n            var num = numero;\n            var splitStr = num.split(\u0027,\u0027);\n            var splitLeft = splitStr[0];\n            var splitRight = splitStr.length \u003e 1 ? \",\" + splitStr[1] : \u0027\u0027;\n            var regx = /(\\d+)(\\d{3})/;\n            while (regx.test(splitLeft)) {\n                splitLeft = splitLeft.replace(regx, \u0027$1\u0027 + \".\" + \u0027$2\u0027);\n            }\n            return splitLeft + splitRight;\n        }\n        $(document).ready(function () {\n\n            $(\u0027[data-toggle=\"tooltip\"]\u0027).tooltip();\n            $(\u0027.table tbody\u0027).on(\u0027mouseover\u0027, \u0027tr\u0027, function () {\n                $(\u0027[data-toggle=\"tooltip\"]\u0027).tooltip({\n                    trigger: \u0027hover\u0027,\n                    html: true\n                });\n            });\n            $(\u0027.modal-dialog\u0027).draggable({\n                handle: \".modal-header\"\n            });\n            $(\".numberMiles\").each(function () {\n                $(this).val(SeparadorMilesInput($(this).val().toString()))\n            })\n            //$(\".numberMiles\").val(SeparadorMiles($(this).val().toString()))\n            $(\".numberMiles\").on({\n                \"focus\": function (event) {\n                    $(event.target).select();\n                },\n                \"keyup\": function (event) {\n                    $(event.target).val(function (index, value) {\n                        var valor = value.replace(/[^0-9,]/g, \u0027\u0027);\n                        return SeparadorMilesInput(valor);\n                        /* return value.replace(/\\D/g, \"\")\n                             .replace(/([0-9])([0-9]{3})$/, \u0027$1.$2\u0027)\n                             .replace(/\\B(?=(\\d{3})+(?!\\d)\\.?)/g, \".\");*/\n                    });\n                }\n            });\n        });\n    \u003c/script\u003e\n\u003c/head\u003e\n\n\u003cbody class=\"bodyModal\"\u003e\n    \u003cdiv class=\"page-content\" style=\"border-color:white\"\u003e\n            \u003cdiv class=\"card\"\u003e\n        \u003cdiv class=\"card-body\"\u003e\n            \u003cdiv class=\"x_content\"\u003e\n\t            \u003ctable class=\"table table-striped table-bordered dt-responsive\" id=\"grillaSolicitudLote\" style=\"width:100%\" aria-hidden=\"true\" data-order=\u0027[[ 0, \"desc\" ]]\u0027\u003e\n\t\t            \u003cthead\u003e\n\t\t\t            \u003ctr\u003e\n                            \u003cth scope=\"col\"\u003eNÂº Sistema\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eExportador\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eEspecie\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003ePresentaciÃ³n\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eCantidad Envases\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eUnidades Muestra\u003c/th\u003e\n                            \u003cth scope=\"col\" class=\"noExport\"\u003eTodos \u003cinput type=\"checkbox\" name=\"chkAll\" id=\"chkAll\" checked /\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eFecha\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eHorario\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eSitio\u003c/th\u003e\n\t\t\t            \u003c/tr\u003e\n\t\t            \u003c/thead\u003e\n                    \u003ctbody id=\"indexTbody\"\u003e\n                            \u003ctr\u003e\n                                \u003ctd\u003e151318\u003c/td\u003e\n                                \u003ctd\u003e76918170-9 EXPORTADORA IDAHUE CHILE S.A.\u003c/td\u003e\n                                \u003ctd\u003eMANDARINA\u003c/td\u003e\n                                \u003ctd\u003eFRUTOS\u003c/td\u003e\n                                \u003ctd\u003e2.000 CAJAS\u003c/td\u003e\n                                \u003ctd\u003e30 CAJAS\u003c/td\u003e\n                                \u003ctd class=\"noExport\"\u003e                                    \u003cinput type=\"checkbox\" class=\"loteSol\" onclick=\"ActualizarSeleccionL(151318,1)\" name=\"chkLoteL\" id=\"151318\" value=\"151318\"  /\u003e\n                                \u003c/td\u003e\n                                \u003ctd\u003e\u003c/td\u003e\n                                    \u003ctd\u003e-                                    \u003c/td\u003e\n                                    \u003ctd\u003e\u003c/td\u003e\n                            \u003c/tr\u003e\n                    \u003c/tbody\u003e\n\t                \u003ctfoot align=\"right\"\u003e\n\t\t                \u003ctr class=\"table-info\"\u003e\n                            \u003cth scope=\"col\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003eTotal Lotes:\u003c/th\u003e\n                            \u003cth scope=\"col\" align=\"left\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003ePor Agendar:\u003c/th\u003e\n                            \u003cth scope=\"col\" align=\"left\"\u003e\u003c/th\u003e\n                            \u003cth scope=\"col\"\u003e\u003c/th\u003e\n                        \u003c/tr\u003e\n\t                \u003c/tfoot\u003e\n\t            \u003c/table\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"card\"\u003e\n        \u003cdiv class=\"card-body\"\u003e\n            \u003cdiv class=\"form-group row d-flex justify-content-center alert alert-info\"\u003e\n                \u003cdiv class=\"col-sm-2\"\u003e\u003cbutton type=\"button\" class=\"btn btn-primary\" onClick=\"Volver()\"\u003e \u003cem class=\"fas fa-undo-alt\"\u003e\u003c/em\u003e Salir\u003c/button\u003e\u003c/div\u003e\n                \u003cdiv class=\"col-sm-2\"\u003eFecha Servicio:\u003c/div\u003e\n                \u003cdiv class=\"col-sm-3\"\u003e\n                    \u003cselect name=\"FechaInspeccion\" id=\"FechaInspeccion\"  class=\"form-control form-control-sm\" onchange=\"CargaSitio()\"\u003e\n                        \u003coption value=\"\"\u003e[ Seleccione Fecha ]\u003c/option\u003e\n                                \u003coption value=\"25-08-2026\"\u003e25-08-2026\u003c/option\u003e\n                                \u003coption value=\"26-08-2026\"\u003e26-08-2026\u003c/option\u003e\n                    \u003c/select\u003e                    \n                \u003c/div\u003e\n                \u003cdiv class=\"col-sm-3\"\u003e                        \u003cbutton type=\"button\" class=\"btn btn-info\" id=\"btnActualizaHorario\" onClick=\"CargaSitio()\"\u003e \u003cem class=\"las la-sync-alt\"\u003e\u003c/em\u003e Actualizar Horario\u003c/button\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n         \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"card-body\" id=\"idSitioInspeccion\"\u003e\n    \u003c/div\u003e\n\n   \t\u003cform name=\"frmAccionSolicitud\" id=\"frmAccionSolicitud\" method=\"post\"\u003e\n        \u003cinput type=\"hidden\" name=\"idSolicitudServicio\" id=\"idSolicitudServicioAcc\" value=\"0\" /\u003e\n        \u003cinput type=\"hidden\" name=\"idTipoDespacho\" id=\"idTipoDespachoAcc\" value=\"3\" /\u003e\n    \u003cinput name=\"__RequestVerificationToken\" type=\"hidden\" value=\"[VALOR_SENSIBLE_REDACTADO]\" /\u003e\u003c/form\u003e\n\n\u003cscript\u003e\n    $(document).ready(function () {\n        initTableSolLoteAg();\n\n        $(\u0027#chkAll\u0027).on(\u0027click\u0027, function(){\n            var table = initTableSolLotes();\n            var rows = table.rows({ \u0027search\u0027: \u0027applied\u0027 }).nodes();\n            $(\u0027input[type=\"checkbox\"]\u0027, rows).prop(\u0027checked\u0027, this.checked);\n            ActualizacionMasivaL(\u0027loteSol\u0027,2);\n        });\n\n        // Handle click on checkbox to set state of \"Select all\" control\n        $(\u0027#grillaSolicitudLote tbody\u0027).on(\u0027change\u0027, \u0027input[type=\"checkbox\"]\u0027, function(){\n            // If checkbox is not checked\n            if(!this.checked){\n                var el = $(\u0027#chkAll\u0027).get(0);\n                // If \"Select all\" control is checked and has \u0027indeterminate\u0027 property\n                if(el \u0026\u0026 el.checked \u0026\u0026 (\u0027indeterminate\u0027 in el)){\n                // Set visual state of \"Select all\" control\n                // as \u0027indeterminate\u0027\n                el.indeterminate = true;\n                }\n            }\n        });\n\n    });\n\n    function CheckTodos(){\n        var table = initTableSolLotes();\n        var rows = table.rows({ \u0027search\u0027: \u0027applied\u0027 }).nodes();\n        console.log(rows)\n        $(\u0027input[type=\"checkbox\"]\u0027, rows).prop(\u0027checked\u0027, true);\n        ActualizacionMasivaL(\u0027loteSol\u0027,2);    \n    }\n\n    function RefreshListaSolLoteAg() {\n        var tablex = initTableSolLoteAg();\n        tablex.ajax.reload(function (json) { });\n    }\n\n    var idSeleccion = new Array();\n    function ActualizarSeleccionL(key,accion) {\n        $(\u0027.loteSol\u0027).each(function (key) {\n            if ($(\"#\" + this.id).prop(\"checked\") == true) {\n                var existe = idSeleccion.includes(this.id)\n                if (existe == false) {\n                    idSeleccion.push(this.id);\n                }\n            }\n\n            $(\"#\" + this.id).prop(\"disabled\",true);\n        });\n        if(accion == 1){\n            CargaSitio();\n        }\n    }\n\n\n    function ActualizacionMasivaL(opSel,op) {\n        idSeleccion = new Array();\n        $(\".\"+opSel).each(function () {\n            ActualizarSeleccionL(this.id,op)\n        });\n        CargaSitio();\n    }\n\n    function CargaSitio(){\n        $(\"#idSitioInspeccion\").empty();\n        $(\"#btnActualizaHorario\").prop(\"disabled\",true);\n\n        idSeleccion = new Array();\n        var form = this;\n        // Iterate over all checkboxes in the table\n        var table = initTableSolLotes();\n        table.$(\u0027input[type=\"checkbox\"]\u0027).each(function(){\n            if(this.checked){\n                idSeleccion.push(this.value);\n            }\n        });\n\n        if($(\"#FechaInspeccion\").val() != \"\"){\n            var a = true;\n            checkeados = 0;\n            if (idSeleccion.length == 0) a = false;\n            if (a == true) {\n\t\t        $.ajax({\n\t\t\t        url: \u0027/SolicitudServicio/SitioInspeccion\u0027,\n\t\t\t        async:true,\n\t\t\t        contentType: \"application/x-www-form-urlencoded\",\n\t\t\t        dataType: \"html\",\n\t\t\t        global: true,\n\t\t\t        ifModified: false,\n\t\t\t        processData:true,\n\t\t\t        data:{\n                        idSolicitudServicio: $(\"#idSolicitudServicioAcc\").val(), \n                        tipoDespacho: $(\"#idTipoDespachoAcc\").val(),\n                        fechaInspeccion:$(\"#FechaInspeccion\").val(),\n                        loteSel: idSeleccion,\n                        esSinHora: \"False\"\n                    },\n\t\t\t        beforeSend: function(){\n\t\t\t\t        $(\"#idSitioInspeccion\").empty()\n\t\t\t\t        },\n\t\t\t        success: func"
