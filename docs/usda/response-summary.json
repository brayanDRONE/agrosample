         },\n                \"keyup\": function (event) {\n                    $(event.target).val(function (index, value) {\n                        var valor = value.replace(/[^0-9,]/g, \u0027\u0027);\n                        return SeparadorMilesInput(valor);\n                        /* return value.replace(/\\D/g, \"\")\n                             .replace(/([0-9])([0-9]{3})$/, \u0027$1.$2\u0027)\n                             .replace(/\\B(?=(\\d{3})+(?!\\d)\\.?)/g, \".\");*/\n                    });\n                }\n            });\n        });\n    \u003c/script\u003e\n\u003c/head\u003e\n\n\u003cbody class=\"bodyModal\"\u003e\n    \u003cdiv class=\"page-content\" style=\"border-color:white\"\u003e\n        \n        \u003cdiv class=\"card card-primary card-outline card-outline-tabs\"\u003e\n            \u003cdiv class=\"card-header p-0 border-bottom-0\"\u003e\n                \u003cul class=\"nav nav-tabs\" id=\"custom-tabs-four-tab\" role=\"tablist\"\u003e\n                        \u003cli class=\"nav-item alert demo-avatar-group\"\u003e\n                        \u003ca class=\"nav-link\" onclick=\"CargaPrograma(185,\u002726/08/2026\u0027)\" id=\"custom-tabs-four-home-tab\" data-toggle=\"pill\" href=\"#custom-tabs-four-home\" role=\"tab\" aria-controls=\"custom-tabs-four-home\" aria-selected=\"true\"\u003eSITIO COQUIMBO                                 \u003cspan class=\"avatar avatar-xs bg-success rounded-circle\"\u003e1\u003c/span\u003e\n                        \u003c/a\u003e\n                    \u003c/li\u003e\n                        \u003cli class=\"nav-item alert demo-avatar-group\"\u003e\n                        \u003ca class=\"nav-link\" onclick=\"CargaPrograma(180,\u002726/08/2026\u0027)\" id=\"custom-tabs-four-home-tab\" data-toggle=\"pill\" href=\"#custom-tabs-four-home\" role=\"tab\" aria-controls=\"custom-tabs-four-home\" aria-selected=\"true\"\u003eSITIO LOS LIRIOS                                 \u003cspan class=\"avatar avatar-xs bg-danger rounded-circle\"\u003e0\u003c/span\u003e\n                        \u003c/a\u003e\n                    \u003c/li\u003e\n                        \u003cli class=\"nav-item alert demo-avatar-group\"\u003e\n                        \u003ca class=\"nav-link\" onclick=\"CargaPrograma(156,\u002726/08/2026\u0027)\" id=\"custom-tabs-four-home-tab\" data-toggle=\"pill\" href=\"#custom-tabs-four-home\" role=\"tab\" aria-controls=\"custom-tabs-four-home\" aria-selected=\"true\"\u003eSITIO TENO                                 \u003cspan class=\"avatar avatar-xs bg-success rounded-circle\"\u003e1\u003c/span\u003e\n                        \u003c/a\u003e\n                    \u003c/li\u003e\n                        \u003cli class=\"nav-item alert demo-avatar-group\"\u003e\n                        \u003ca class=\"nav-link\" onclick=\"CargaPrograma(181,\u002726/08/2026\u0027)\" id=\"custom-tabs-four-home-tab\" data-toggle=\"pill\" href=\"#custom-tabs-four-home\" role=\"tab\" aria-controls=\"custom-tabs-four-home\" aria-selected=\"true\"\u003eSITIO VALPARAISO                                 \u003cspan class=\"avatar avatar-xs bg-success rounded-circle\"\u003e1\u003c/span\u003e\n                        \u003c/a\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"card-body\"\u003e\n                \u003cdiv class=\"tab-content\" id=\"custom-tabs-four-tabContent\"\u003e\n                    \u003cdiv class=\"tab-pane fade show active justify-content-center\" id=\"idAreaInspeccion\" role=\"tabpanel\" aria-labelledby=\"custom-tabs-four-home-tab\"\u003e\n                        \u003cdiv class=\"alert alert-info col-sm-12 d-flex justify-content-center text-danger\"\u003e\u003cem class=\"las la-exclamation-circle text-danger\" style=\"font-size: 22px;\"\u003e\u003c/em\u003e Seleccione sitio de inspecciÃ³n\u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u